# Database
DATABASE_URL=postgresql://saahvik:saahvik@localhost:5432/saahvik?schema=public

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=info@saahvik.com

# SMS (MSG91 — gated on TRAI DLT registration)
MSG91_API_KEY=
MSG91_DLT_TEMPLATE_ID=

# WhatsApp (gated on reseller onboarding)
WHATSAPP_PROVIDER_API_KEY=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# File storage — AWS S3 (private, for resident photos/ID docs)
AWS_S3_BUCKET=saahvik-private
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# File storage — Cloudflare R2 (public/PDF receipts)
CLOUDFLARE_R2_BUCKET=saahvik-public
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Monitoring
SENTRY_DSN=

# Server
PORT=3000
NODE_ENV=development

# Local file storage (dev fallback when S3 not configured)
LOCAL_UPLOAD_DIR=./uploads
